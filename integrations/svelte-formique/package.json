{
  "name": "svelte-formique",
  "private": false,
  "version": "0.1.1",
  "description": "Formique is a robust and elegant Web Content Accessibility Guidelines (WCAG) and Web Accessibility Initiative - Accessible Rich Internet Applications (WAI-ARIA)-compliant form-building library tailored for JavaScript enthusiasts.",
  "keywords": [
    "svelte",
    "form builder",
    "formique",
    "UI",
    "web"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "package": "vite build"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^4.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "svelte-formique": "^0.1.1"
  },
  "main": "src/lib/Formique.js",
  "exports": {
    ".": "./src/lib/Formique.js"
  },
  "files": [
    "src/lib/Formique.js"
  ]
}
